{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"], "jsx": "preserve", "noEmit": true, "allowJs": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }, "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
